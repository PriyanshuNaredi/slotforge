# Server-side only. Where the Next.js proxy and auth broker reach the Go API.
# Never prefix with NEXT_PUBLIC_ — the browser talks to /api/v1 on this origin only.
API_PROXY_ORIGIN=http://127.0.0.1:8080

# Used only by scripts/seed-provider.mjs (dev tooling)
# Defaults to the repo-root .env value when unset.
# DATABASE_URL=postgres://slotforge:secret@localhost:5432/slotforge
