# SlotForge API environment variables.
# Placeholders only. Copy to .env and fill in real values; never commit .env.

# Application.
APP_ENV=development
APP_PORT=8080

# Database.
DATABASE_URL=postgres://user:password@localhost:5432/slotforge?sslmode=disable

# Docker Compose Postgres credentials (local development only).
# POSTGRES_PASSWORD must match the password embedded in DATABASE_URL above.
# Local-dev placeholder — pick your own value; never reuse it anywhere real.
POSTGRES_PASSWORD=change-me-local-dev-only

# Redis.
REDIS_ADDR=localhost:6379

# Authentication.
JWT_SECRET=replace-with-a-secret-of-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=168h

# Email delivery (Resend). Leave RESEND_API_KEY empty to disable email delivery.
RESEND_API_KEY=re_replace-with-your-resend-api-key
EMAIL_FROM=SlotForge <noreply@yourdomain.com>

# Email worker (optional; defaults shown).
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_POLL_INTERVAL=15s
EMAIL_WORKER_RECOVERY_INTERVAL=1m
EMAIL_WORKER_STALE_AFTER=5m
